# ================================================
# POLITICA MONITOR v2.0 - Firebase Edition
# Copiar este archivo como .env y completar valores
# ================================================

# APP
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# JWT SECRET (generá uno seguro: openssl rand -base64 64)
JWT_SECRET=cambia_esto_por_una_clave_muy_segura_y_larga_123456

# FIREBASE - Opción 1: Service Account JSON en variable de entorno
# Ir a Firebase Console > Project Settings > Service Accounts > Generate new private key
# Copiar todo el contenido del JSON y pegarlo aquí en una sola línea
FIREBASE_SERVICE_ACCOUNT=

# FIREBASE - Opción 2: Apuntar al archivo JSON de la service account
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# GEMINI AI - Para análisis de sentimiento
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# NEWS API - Para menciones en medios (gratis hasta 100 req/día en dev)
# https://newsapi.org/register
NEWS_API_KEY=

# SMTP - Para alertas por email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# TWILIO - Para alertas WhatsApp (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SCRAPING
SCRAPE_INTERVAL_MINUTES=15
